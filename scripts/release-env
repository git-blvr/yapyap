# Sourced before building a binary people download: `source scripts/release-env
# TARGET`, then plain `cargo build --target TARGET`. Rust embeds source paths for panic messages, and C's __FILE__ ends
# up in error messages too; they'd name the folders of the machine that built
# it, its owner's home folder among them. These flags name none.
# CARGO_ENCODED_RUSTFLAGS replaces .cargo/config.toml's rustflags, so a
# target's own come along here.
circord_release_target=${1:?usage: source scripts/release-env TARGET}
circord_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# Widest first: rustc and Clang take the last mapping that matches.
circord_maps=("$HOME=/home" "${CARGO_HOME:-$HOME/.cargo}=/cargo" "$circord_root=/circord")
circord_rust=()
circord_c=()
for map in "${circord_maps[@]}"; do
  circord_rust+=("--remap-path-prefix=$map")
  circord_c+=("-ffile-prefix-map=$map")
done
case "$circord_release_target" in
  x86_64-pc-windows-msvc)
    # Match LiveKit's Windows runtime linkage, as .cargo/config.toml does.
    circord_rust=(-Ctarget-feature=+crt-static "${circord_rust[@]}")
    # cargo-xwin compiles C with clang-cl, which takes Clang's flags this way.
    circord_c=("${circord_c[@]/#//clang:}") ;;
  x86_64-unknown-linux-gnu) ;;
  *) echo "scripts/release-env: no flags known for $circord_release_target" >&2; return 2 ;;
esac
CARGO_ENCODED_RUSTFLAGS=$(IFS=$'\x1f'; printf '%s' "${circord_rust[*]}")
export CARGO_ENCODED_RUSTFLAGS
# The cc crate reads only the first of CFLAGS_<target> and its fallbacks, and
# `cargo xwin build` sets that one, so take its environment, which adds to
# these rustflags, and add the C flags to what it sets.
circord_target_flags=${circord_release_target//-/_}
if [[ "$circord_release_target" == *-windows-msvc ]]; then
  eval "$(cargo xwin env --target "$circord_release_target")"
  # thorvg-sys tells bindgen's libclang `--target=x86_64-none-elf` on every
  # cross build, which can't read the MSVC headers. bindgen adds these
  # arguments after a build script's, and Clang takes the last target.
  circord_bindgen="BINDGEN_EXTRA_CLANG_ARGS_$circord_target_flags"
  export "$circord_bindgen=${!circord_bindgen:-} --target=$circord_release_target"
fi
circord_cflags="CFLAGS_$circord_target_flags" circord_cxxflags="CXXFLAGS_$circord_target_flags"
export "$circord_cflags=${!circord_cflags:-} ${circord_c[*]}"
export "$circord_cxxflags=${!circord_cxxflags:-} ${circord_c[*]}"
unset circord_release_target circord_root circord_maps circord_rust circord_c map \
  circord_target_flags circord_cflags circord_cxxflags circord_bindgen
